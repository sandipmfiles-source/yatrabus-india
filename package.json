{
  "name": "india-smart-bus",
  "version": "1.0.0",
  "private": true,
  "description": "India-Wide Smart Bus Directory, Community-Powered Live Tracking & Android App",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node --loader ts-node/esm backend/src/server.ts",
    "test": "node scripts/run-tests.mjs",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "qa:phase6": "node scripts/phase6-audit.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "overrides": {
    "rimraf": {
      "glob": "^14.0.3"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.11",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vite": "^8.3.5"
  },
  "keywords": [
    "bus-tracking",
    "public-transport",
    "india-bus",
    "postgis",
    "community-powered",
    "gps-confidence",
    "open-street-map",
