{
  "name": "india-smart-bus-platform",
  "version": "1.0.0",
  "private": true,
  "description": "India-Wide Smart Bus Directory, Community-Powered Live Tracking & Android App",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node tests/run-all-tests.js",
