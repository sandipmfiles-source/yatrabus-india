# ==========================================
# YatraBus - India-Wide Smart Bus Platform
# Environment Configuration Template
# ==========================================

NODE_ENV=development
PORT=5000
# Comma-separated exact browser origins. Production must list each deployed web origin.
# Native Capacitor HTTP requests and same-origin requests do not need wildcard CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://localhost
# Set to the exact trusted reverse-proxy hop count; keep 0 when directly exposed.
TRUST_PROXY_HOPS=0
API_BASE_URL=http://localhost:5000/api
# Frontend build-time API URL; leave blank when the web app and Express API share one host.
VITE_API_BASE_URL=
# Public HTTPS frontend origin used for printable stop QR links.
VITE_PUBLIC_APP_URL=

# Durable backend state. Use a persistent mounted disk or PostgreSQL in production.
YATRIBUS_DATA_FILE=./data/yatribus-state.json

# Super Admin Authentication (set real values only in hosting secrets)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=


MAX_JOURNEY_SESSION_HOURS=12
GPS_ACCURACY_THRESHOLD_METERS=100
GPS_FRESHNESS_LIVE_SECONDS=120
GPS_FRESHNESS_STALE_SECONDS=600
MIN_SPEED_KMPH=2
MAX_SPEED_KMPH=110

MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX_REQUESTS=300
RATE_LIMIT_CONTRIBUTION_MAX_HOURLY=15
