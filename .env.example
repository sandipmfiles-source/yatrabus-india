# ==========================================
# YatriBus - India-Wide Smart Bus Platform
# Environment Configuration Template
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api
# Required for APK API requests and native background GPS; use deployed backend origin without /api
VITE_API_BASE_URL=https://your-public-yatribus-domain.example
PUBLIC_API_BASE_URL=https://your-public-yatribus-domain.example

# Database Configuration (PostgreSQL / PostGIS for Production, SQLite with Spatial Polyline for Local Dev)
DATABASE_URL=postgresql://yatribus_admin:change_me_strong_password@localhost:5432/yatribus_db
DATABASE_SSL=false
USE_EMBEDDED_SQLITE=true

# Admin Authentication
ADMIN_JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
ADMIN_SESSION_EXPIRY_HOURS=24
INITIAL_ADMIN_EMAIL=admin@yatribus.in
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Tracking & Geolocation Engine Limits
MAX_JOURNEY_SESSION_HOURS=12
GPS_ACCURACY_THRESHOLD_METERS=100
GPS_FRESHNESS_LIVE_SECONDS=120
GPS_FRESHNESS_STALE_SECONDS=600
MIN_SPEED_KMPH=2
MAX_SPEED_KMPH=110

# Map Tiles (Default: OpenStreetMap Humanitarian / Standard - ₹0 cost)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Rate Limiting & Anti-Abuse
RATE_LIMIT_PUBLIC_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_PUBLIC_MAX_REQUESTS=300
RATE_LIMIT_CONTRIBUTION_MAX_HOURLY=15
