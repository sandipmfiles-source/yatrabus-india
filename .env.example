# ==========================================
# YatraBus - India-Wide Smart Bus Platform
# Environment Configuration Template
# ==========================================

NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api

# Durable backend state. Use a persistent mounted disk or PostgreSQL in production.
YATRIBUS_DATA_FILE=./data/yatribus-state.json

# Super Admin Authentication (set real values only in hosting secrets)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# Google Identity / owner sign-in. Use the same Web Client ID in the backend and Vite build; never put a client secret in the APK.
GOOGLE_OAUTH_CLIENT_ID=
OWNER_JWT_SECRET=
VITE_GOOGLE_CLIENT_ID=

MAX_JOURNEY_SESSION_HOURS=12
GPS_ACCURACY_THRESHOLD_METERS=100
GPS_FRESHNESS_LIVE_SECONDS=120
GPS_FRESHNESS_STALE_SECONDS=600
MIN_SPEED_KMPH=2
MAX_SPEED_KMPH=110

MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX_REQUESTS=300
RATE_LIMIT_CONTRIBUTION_MAX_HOURLY=15
